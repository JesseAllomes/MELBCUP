{
  "_comment": "Owner-approved ceilings for the MELBCUP Azure function and web container app. Raising any number or adding a list item needs the owner (tools/cost_guard.py rule C10).",
  "prices": {
    "flex_gb_s": 0.000026,
    "flex_per_million_exec": 0.40,
    "flex_free_gb_s": 100000,
    "flex_free_exec": 250000,
    "aca_vcpu_s": 0.000024,
    "aca_gib_s": 0.000003,
    "aca_free_vcpu_s": 180000,
    "aca_free_gib_s": 360000,
    "aca_per_million_requests": 0.40,
    "aca_free_requests": 2000000
  },
  "budget_usd_month": {
    "total": 25,
    "hard_cap_function": 70
  },
  "function": {
    "max_instances": 1,
    "max_instance_memory_mb": 512,
    "always_ready": 0,
    "max_function_timeout_s": 60,
    "max_collect_window_days": 10,
    "max_http_concurrent": 10,
    "max_http_outstanding": 20,
    "assumed_http_requests_month": 1000,
    "allowed_functions": {
      "collect": {"timer_max_per_day": 1440},
      "publish": {"timer_max_per_day": 24},
      "racelens_snapshot": {"timer_max_per_day": 180},
      "nba_props_run": {"timer_max_per_day": 72},
      "alerts_due": {"queue": "alerts", "queue_max_per_day": 40, "_comment": "on-demand alerts; melbcup/push_store.py QUEUE_MAX_PER_DAY caps what the web app queues"},
      "reenter": {"route": "github/reenter", "anonymous": true}
    },
    "forbidden_app_settings": ["APPLICATIONINSIGHTS_CONNECTION_STRING", "APPINSIGHTS_INSTRUMENTATIONKEY"]
  },
  "container_app": {
    "_comment": "C11. Worst case = max_replicas running 24/7 for 30 days at the active list price: (replicas*cpu*2592000 - free vCPU-s) * aca_vcpu_s + (replicas*memory_gib*2592000 - free GiB-s) * aca_gib_s + request charge above the free grant. The free grants are per subscription, so other container apps and jobs spend from the same pool.",
    "file": "azure/webapp/melbcup-web.json",
    "min_replicas": 0,
    "max_replicas": 1,
    "max_cpu": 0.25,
    "max_memory_gib": 0.5,
    "workload_profile": "Consumption",
    "assumed_requests_month": 100000
  },
  "jobs": {
    "_comment": "C12. Container Apps jobs for MELBCUP (azure/jobs/*.json). Worst case = runs/day x 30 x replicaTimeout x (cpu x aca_vcpu_s + memory x aca_gib_s), without the free grant, added to the C3 total. Adding a job or raising a number needs the owner (C10).",
    "image_repository": "ghcr.io/jesseallomes/melbcup-nba",
    "allowed": {
      "melbcup-nba": {"max_runs_per_day": 2, "max_replica_timeout_s": 300, "max_cpu": 1.0, "max_memory_gi": 2, "secrets": ["odds-api-key"]}
    }
  },
  "allowed_resource_types": [
    "Microsoft.App/managedEnvironments/managedCertificates",
    "Microsoft.OperationalInsights/workspaces",
    "Microsoft.Web/sites",
    "Microsoft.Web/serverFarms",
    "Microsoft.Web/staticSites",
    "Microsoft.Storage/storageAccounts",
    "Microsoft.KeyVault/vaults",
    "Microsoft.App/managedEnvironments",
    "Microsoft.App/jobs",
    "Microsoft.App/containerApps",
    "Microsoft.ManagedIdentity/userAssignedIdentities"
  ],
  "scan": {
    "code": ["azure/**/*.py", "tools/live_collector.py", "tools/cost_guard.py"],
    "text": ["azure/**/*", "tools/live_collector.py", ".github/workflows/*"],
    "secret_allowlist": {"da2-": ["tools/live_collector.py"]}
  },
  "workflows": {
    "max_job_timeout_min": 360,
    "max_cron_fires_per_day": 300,
    "self_dispatch_workflows": [],
    "workflow_run_allowed": {}
  },
  "ratchet": {
    "unbounded_subprocess": 1,
    "unbounded_while": 0
  }
}
