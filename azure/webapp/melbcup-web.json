            "secretRef": "odds-api-key"
          }
        ],
        "probes": [
          {
            "type": "Startup",
            "httpGet": {
              "path": "/healthz",
              "port": 8000
            },
            "periodSeconds": 3,
            "timeoutSeconds": 3,
            "failureThreshold": 20
          },
          {
            "type": "Liveness",
            "httpGet": {
              "path": "/healthz",
              "port": 8000
            },
            "periodSeconds": 30,
            "timeoutSeconds": 5,
            "failureThreshold": 3
          },
          {
            "type": "Readiness",
            "httpGet": {
              "path": "/healthz",
              "port": 8000
            },
            "periodSeconds": 10,
            "timeoutSeconds": 5,
            "failureThreshold": 3
          }
        ]
      }
    ],
    "scale": {
      "minReplicas": 0,
      "cooldownPeriod": 10800,
      "maxReplicas": 1,
      "rules": [
        {
          "name": "http",
          "http": {
            "metadata": {
              "concurrentRequests": "50"
            }
          }
        }
      ]
