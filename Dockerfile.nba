# NBA daily job image (Azure Container Apps job melbcup-nba, azure/jobs/melbcup-nba.json): adds the
# night's finished games to the history, settles yesterday's legs and builds today's board with model
# v3 (tools/nba/daily.py). Code only: the data lives in the Blob container `nba`. No secrets inside.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN pip install --no-cache-dir numpy==2.3.4 scipy==1.16.3 azure-identity==1.25.1 azure-storage-blob==12.27.1 tzdata==2025.2 \
    && useradd --system --create-home --uid 10001 app
WORKDIR /app
COPY tools/nba/board.py tools/nba/tune.py tools/nba/settle.py tools/nba/espn_history.py tools/nba/daily.py tools/nba/legs.py tools/nba/model_v3.json /app/tools/nba/
COPY azure/function/nba_legs.py /app/azure/function/
USER app
ENTRYPOINT ["python3", "/app/tools/nba/daily.py"]
