mentStewards": null, "timing": null, "race": {"date": "2025-12-23", "isTrial": 0, "isJumpOut": 0, "venueAbbr": "BATH", "distance": "1300m", "trackCondition": "Good", "trackRating": "3", "class": "BM58", "runnersCount": 13, "raceNumber": 6}}, {"horseName": "Halo Phenomena", "finish": 3, "finishAbv": "3rd", "startingPrice": null, "margin": "1.77L", "weightCarried": "60.5kg", "jockeyName": "A.Bullock", "barrierNumber": 8, "positionAtSettledAbv": null, "positionAt800Abv": "5th", "positionAt400Abv": "4th", "timeSectional": "0", "standardTimeDifference": null, "comment": "Away fairly. Not pushed early & raced behind Mid Field Two Wide (3L from lead). Held Ground midrace & improving slowly from 500m. Pushed to quicken Six Wide (2L from lead) on home turn. Pressured Six Wide @ 250m & looked a chance @ 200m. Laid in & only held ground in last 100m. # Sound 1st-up run", "commentStewards": null, "timing": null, "race": {"date": "2025-12-05", "isTrial": 0, "isJumpOut": 0, "venueAbbr": "MDGE", "distance": "1200m", "trackCondition": "Good", "trackRating": "3", "class": "CTRY BM58", "runnersCount": 8, "raceNumber": 7}}, {"horseName": "Halo Phenomena", "finish": 2, "finishAbv": "2nd", "startingPrice": null, "margin": "1.51L", "weightCarried": null, "jockeyName": "A.Roper", "barrierNumber": 3, "positionAtSettledAbv": null, "positionAt800Abv": null, "positionAt400Abv": null, "timeSectional": "0", "standardTimeDifference": null, "comment": null, "commentStewards": null, "timing": null, "race": {"date": "2025-11-19", "isTrial": 1, "isJumpOut": 0, "venueAbbr": "SCNE", "distance": "900m", "trackCondition": "Soft", "trackRating": "5", "class": "OPEN-BT", "runnersCount": 7, "raceNumber": 8}}, {"horseName": "Halo Phenomena", "finish": 10, "finishAbv": "10th", "startingPrice": "$2.60", "margin": "11.63L", "weightCarried": "55.5kg", "jockeyName": "B.Nock", "barrierNumber": 1, "positionAtSettledAbv": null, "positionAt800Abv": "7th", "positionAt400Abv": "9th", "timeSectional": "3337", "standardTimeDifference": null, "comment": "Just a Bit Slow Out from the Inside . was 6th early within 4 Lengths then clipped heels near 500m. Ridden Along early Straight Just Off Mid-Field , Not Knocked About at all last 150m (vetted - nothing amiss) # chkecked at 500m", "commentStewards": "After taking evidence from the riders involved, it was EST that near the 600m, a rnr had improved quickly to be awkwardly placed near the heels of another rnr, when that runner shifted in & away from another rnr. It was EST further that after passing the 600m, that the three rnrs were racing tight and the other rnr was being ridden along in an attempt to clear the rnr and as a result, that rnr shifted in & away from that rnr causing the other rnr to be taken in resulting in Halo Phenomena being crowded and severely checked.  A post race veterinary examination revealed no abs.", "timing": null, "race": {"date": "2025-09-30", "isTrial": 0, "isJumpOut": 0, "venueAbbr": "TAMW", "distance": "1000m", "trackCondition": "Good", "trackRating": "4", "class": "CTRY CL3", "runnersCount": 10, "raceNumber": 7}}, {"horseName": "Halo Phenomena", "finish": 3, "finishAbv": "3rd", "startingPrice": null, "margin": "1.08L", "weightCarried": null, "jockeyName": "S.Grima", "barrierNumber": 0, "positionAtSettledAbv": null, "positionAt800Abv": null, "positionAt400Abv": null, "timeSectional": "3324", "standardTimeDifference": null, "comment": null, "commentStewards": null, "timing": null, "race": {"date": "2025-09-17", "isTrial": 1, "isJumpOut": 0, "venueAbbr": "MWBK", "distance": "800m", "trackCondition": "Good", "trackRating": "4", "class": "OPEN-BT", "runnersCount": 6, "raceNumber": 10}}, {"horseName": "Halo Phenomena", "finish": 1, "finishAbv": "1st", "startingPrice": "$1.95", "margin": "3.25L", "weightCarried": "55kg", "jockeyName": "I.Neale", "barrierNumber": 1, "positionAtSettledAbv": null, "positionAt800Abv": "1st", "positionAt400Abv": "1st", "timeSectional": "0", "standardTimeDifference": null, "comment"