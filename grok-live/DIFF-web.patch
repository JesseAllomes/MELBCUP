+    <div class="sp-also">
+      <i class="{{ row.tone }}">{{ row.pct }}</i>
+      <span><b>{{ row.name }}</b> ${{ '%.2f' % row.price }}</span>
+    </div>
+    {% endfor %}
+    {% endfor %}
+    {% endfor %}
+    <p class="sp-meta">{{ live.note }} Same-game legs are linked, so they are listed under the match and not stacked into the multi.</p>
+    {% else %}
+    <p class="sp-empty">{{ live.empty or games_note }}</p>
+    {% if live.error %}<p class="sp-meta">{{ live.error }}</p>{% endif %}
+    {% endif %}
+
+  {% elif tab == 'build' %}
+    {% if built %}
+    <p class="sp-chance {{ built.tone }}">{{ built.pct }}<small>%</small></p>
+    <p class="sp-lead">{{ built.legs }} leg{% if built.legs != 1 %}s{% endif %} · ${{ '%.2f' % built.multi }}</p>
+    {% if not built.ready %}<p class="sp-meta">Still under $2. Add a leg.</p>{% endif %}
+    {% for line in built.lines %}<p class="sp-meta">{{ line }}</p>{% endfor %}
+    {% elif hero %}
+    <p class="sp-meta">The model would take {{ hero.line }}, {{ hero.pct }}%. Set a number of legs to build your own.</p>
+    {% else %}
+    <p class="sp-empty">{{ empty }}</p>
+    {% endif %}
+    {% if singles %}
+    <form class="sp-form" method="get" action="{{ here }}">
+      <input type="hidden" name="tab" value="build">
+      {% for row in singles_main %}
+      <label class="sp-also">
+        <input type="number" name="n_{{ row.id }}" min="0" max="12" inputmode="numeric" value="{{ row.count }}" aria-label="Legs of {{ row.label }} {{ row.band }}">
+        <span><b>{{ row.label }}</b> {{ row.band }} · ${{ '%.2f' % row.price }}</span>
+      </label>
+      {% endfor %}
+      {% if singles_rest %}
+      <details class="sp-more"><summary>Lower chances</summary>
+      {% for row in singles_rest %}
+      <label class="sp-also">
+        <input type="number" name="n_{{ row.id }}" min="0" max="12" inputmode="numeric" value="{{ row.count }}" aria-label="Legs of {{ row.label }} {{ row.band }}">
+        <span><b>{{ row.label }}</b> {{ row.band }} · ${{ '%.2f' % row.price }}</span>
+      </label>
+      {% endfor %}
+      </details>
+      {% endif %}
+      <button type="submit">Update the multi</button>
+    </form>
+    {% endif %}
+
+  {% elif tab == 'challenge' %}
+    {% set ch = challenge %}
+    <p class="sp-kicker">Stage 1 of {{ ch.stages }} · ${{ '%g' % ch.start }} toward ${{ '%g' % ch.goal }}</p>
+    {% if ch.ticket %}
+    <p class="sp-chance {{ ch.ticket.tone }}">{{ ch.ticket.pct }}<small>%</small></p>
+    <p class="sp-lead">{{ ch.ticket.sport_name }} · {{ ch.ticket.line }}</p>
+    <p class="sp-meta">This stage needs about {{ '%.2f' % ch.x }}x. This ticket pays ${{ '%.2f' % ch.ticket.multi }}. {% if ch.plain %}The best $2 stack is {{ ch.plain.pct }}%, and it does not have to pay this stage.{% endif %}</p>
+    {% else %}
+    <p class="sp-empty">{{ empty }}</p>
+    {% endif %}
+    <form class="sp-form sp-goal" method="get" action="{{ here }}">
+      <input type="hidden" name="tab" value="challenge">
+      <label>Start $<input name="chstart" inputmode="decimal" value="{{ '%g' % ch.start }}"></label>
+      <label>Goal $<input name="chgoal" inputmode="decimal" value="{{ '%g' % ch.goal }}"></label>
+      <label>Stages <select name="chn">{% for n in ch.stage_choices %}<option value="{{ n }}"{{ ' selected' if n == ch.stages }}>{{ n }}</option>{% endfor %}</select></label>
+      <button type="submit">Recalculate</button>
+    </form>
+    <p class="sp-meta">One bank for every sport. A loss ends the run. This screen picks the stage. It does not move a balance.</p>
+  {% endif %}
+
+  <nav class="sp-index" aria-label="Sports">
+    <a href="/sports?tab=top" class="{{ 'on' if not sport }}"{% if not sport %} aria-current="page"{% endif %}>All</a>
+    {% for row in sports %}
+    <a href="/sports/{{ row.code }}?tab=multis" class="{{ 'on' if sport == row.code }}"{% if sport == row.code %} aria-current="page"{% endif %}>{{ row.name }}</a>
+    {% endfor %}
+  </nav>
+</section>
+{% endblock %}
