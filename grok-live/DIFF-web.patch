+{% extends "asynym/base.html" %}
+{% block title %}{{ title }} · AsynymBet{% endblock %}
+{% block refresh %}90{% endblock %}
+{% block content %}
+<section class="sp">
+  <p class="sp-kicker">{{ kicker }}</p>
+  <h2 class="sp-title">{{ heading }}</h2>
+  <nav class="sp-tabs" aria-label="{{ heading }}">
+    {% for key, label in tabs %}
+    <a href="{{ here }}?tab={{ key }}" class="{{ 'on' if tab == key }}"{% if tab == key %} aria-current="page"{% endif %}>{{ label }}</a>
+    {% endfor %}
+  </nav>
+
+  {% if tab in ('top', 'multis') %}
+    {% if live.ticket %}
+    <p class="sp-kicker">Tonight · Sportsbet</p>
+    <p class="sp-chance {{ live.ticket.tone }}">{{ live.ticket.pct }}<small>%</small></p>
+    <p class="sp-lead">{{ live.ticket.count }} leg{% if live.ticket.count != 1 %}s{% endif %} · ${{ '%.2f' % live.ticket.multi }}</p>
+    {% for leg in live.ticket.legs %}
+    <div class="sp-also">
+      <i class="{{ leg.tone }}">{{ leg.pct }}</i>
+      <span><b>{{ leg.name }}</b> {{ leg.game }} · ${{ '%.2f' % leg.price }}</span>
+    </div>
+    {% endfor %}
+    <p class="sp-meta">{{ live.ticket.edge }}</p>
+    {% elif live.games %}
+    <p class="sp-empty">These matches are up, and no one-leg-per-game multi reaches $2.</p>
+    {% endif %}
+    {% if live.error %}<p class="sp-meta">{{ live.error }}</p>{% endif %}
+    {% if hero %}
+    {% if live.ticket or live.games %}<p class="sp-kicker sp-next">Past seasons</p>{% endif %}
+    <p class="sp-chance {{ hero.tone }}">{{ hero.pct }}<small>%</small></p>
+    <p class="sp-lead">{% if hub %}{{ hero.sport_name }} · {% endif %}{{ hero.line }}</p>
+    <p class="sp-meta">${{ '%.2f' % hero.multi }} at the floor · {{ (hero.hit * 100) | round(1) }}% of {{ hero.bets }} bets · lower bound {{ (hero.low * 100) | round(1) }}%</p>
+    <p class="sp-meta">{{ hero.edge }}</p>
+    {% for row in rest %}
+    <a class="sp-also" href="{{ row.href }}">
+      <i class="{{ row.tone }}">{{ row.pct }}</i>
+      <span><b>{% if hub %}{{ row.sport_name }}{% else %}{{ row.label }}{% endif %}</b>{% if hub %} {{ row.label }}{% endif %} {{ row.band }} · {{ row.legs }} leg{% if row.legs != 1 %}s{% endif %} · ${{ '%.2f' % row.multi }}</span>
+    </a>
+    {% endfor %}
+    {% elif not live.ticket and not live.games %}
+    <p class="sp-empty">{{ live.empty or empty }}</p>
+    {% endif %}
+
+  {% elif tab == 'ladder' %}
