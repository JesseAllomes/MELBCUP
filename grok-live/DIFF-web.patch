+      <i class="{{ row.best.tone if row.best else '' }}">{{ row.best.pct if row.best else '—' }}</i>
+      <span><b>{{ row.name }}</b> {% if row.best %}{{ row.best.line }}{% else %}History not in yet{% endif %}</span>
