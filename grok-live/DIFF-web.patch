+    {% if live.singles %}</details>{% endif %}
+    {% elif not live.singles %}
+    <p class="sp-empty">{{ live.empty or empty }}</p>
+    {% endif %}
+
+  {% elif tab == 'games' %}
+    {% if live.games %}
+    {% for game in live.games %}
